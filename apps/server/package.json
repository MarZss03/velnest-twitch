{
  "name": "@velnest/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others-on-fail -n types,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.8",
    "@velnest/shared": "workspace:*",
    "fastify": "5.12.7",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
