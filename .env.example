# Optional: blank uses localhost:3001 in development and the page's own origin
# in the compiled app. Set only when intentionally separating web and API.
VITE_REALTIME_URL=

# Server
PORT=3001
WEB_ORIGIN=http://localhost:5173
MOCK_MODE=true
# All signed-in Twitch viewers may join. Optional: subscribers (affiliate/partner only).
TWITCH_ADMISSION=signed-in

# Set MOCK_MODE=false after configuring Twitch; never commit real values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
TWITCH_BROADCASTER_ID=

